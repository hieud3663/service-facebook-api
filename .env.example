DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-secure-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Ho_Chi_Minh

# Facebook Graph API
FACEBOOK_GRAPH_API_VERSION=v22.0
FACEBOOK_APP_ID=your-meta-app-id
FACEBOOK_APP_SECRET=your-meta-app-secret
FACEBOOK_PAGE_ACCESS_TOKEN=your-page-access-token
FACEBOOK_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
FACEBOOK_WEBHOOK_SECRET=your-webhook-signing-secret

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_EVENTS_TOPIC=raw_events
KAFKA_CLIENT_ID=webhook-service
KAFKA_ACKS=all
KAFKA_PUBLISH_TIMEOUT_SECONDS=5

# Optional if you switch to PostgreSQL
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=service_facebook_api
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432

# ─────────────────────────────────────────────
# Alertmanager — SMTP Email Configuration
# ─────────────────────────────────────────────
# Gmail: Vào Google Account → Security → 2-Step Verification → App passwords
# Tạo App Password 16 ký tự (không dùng password thường)
ALERTMANAGER_SMTP_FROM=your-email@gmail.com
ALERTMANAGER_SMTP_AUTH_USERNAME=your-email@gmail.com
ALERTMANAGER_SMTP_AUTH_PASSWORD=xxxx-xxxx-xxxx-xxxx
ALERTMANAGER_EMAIL_TO=recipient@example.com
