DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-secure-key
DEBUG=True
ALLOWED_HOSTS=*
TIME_ZONE=Asia/Ho_Chi_Minh

# MongoDB
MONGO_DB_NAME=core_service_db
MONGO_HOST=mongodb
MONGO_PORT=27017

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_RAW_EVENTS_TOPIC=raw_events
KAFKA_DEAD_LETTER_TOPIC=dead_letter
KAFKA_SEND_FAILED_TOPIC=send_failed
KAFKA_SEND_RETRY_TOPIC=send_retry
KAFKA_REPLY_COMMANDS_TOPIC=reply_commands
KAFKA_CONSUMER_GROUP_ID=core-service
KAFKA_CLIENT_ID=core-service
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_MAX_RETRIES=3
KAFKA_PRODUCER_SEND_TIMEOUT_SECONDS=10
KAFKA_CONSUMER_FAST_RETRIES=1
KAFKA_MAX_POLL_RECORDS=20
KAFKA_POLL_TIMEOUT_MS=3000
KAFKA_CONSUMER_TIMEOUT_MS=5000
KAFKA_CONNECT_MAX_RETRIES=0
KAFKA_CONNECT_BACKOFF_SECONDS=5
KAFKA_API_VERSION_AUTO_TIMEOUT_MS=10000

# Internal API security
CORE_INTERNAL_API_KEY=replace-with-shared-internal-key

# Dify AI
DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=your-dify-api-key-here

# Core moderation policy
CORE_RATE_LIMIT_WINDOW_SECONDS=60
CORE_RATE_LIMIT_MAX_EVENTS=20
CORE_AUTO_REPLY_POSITIVE=True
CORE_AUTO_REPLY_NEGATIVE=True
CORE_AI_MIN_CONFIDENCE=0.6
CORE_POSITIVE_REPLY_MESSAGE=Cam on ban da ung ho shop!
CORE_NEGATIVE_REPLY_MESSAGE=Rat xin loi vi trai nghiem chua tot, ben minh se kiem tra ngay.

# Circuit breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=30
