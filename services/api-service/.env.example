DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-secure-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,api-service
TIME_ZONE=Asia/Ho_Chi_Minh

# Facebook Graph API
FACEBOOK_GRAPH_API_VERSION=v25.0
FACEBOOK_APP_ID=your-meta-app-id
FACEBOOK_APP_SECRET=your-meta-app-secret
FACEBOOK_PAGE_ACCESS_TOKEN=your-page-access-token

# Kafka command worker
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_REPLY_COMMANDS_TOPIC=reply_commands
KAFKA_SEND_FAILED_TOPIC=send_failed
KAFKA_CONSUMER_GROUP_ID=api-service
KAFKA_CLIENT_ID=api-service
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_MAX_RETRIES=3
KAFKA_MAX_POLL_RECORDS=20
KAFKA_POLL_TIMEOUT_MS=3000
KAFKA_CONSUMER_TIMEOUT_MS=5000
KAFKA_CONNECT_MAX_RETRIES=0
KAFKA_CONNECT_BACKOFF_SECONDS=5
KAFKA_API_VERSION_AUTO_TIMEOUT_MS=10000
KAFKA_PRODUCER_SEND_TIMEOUT_SECONDS=10
